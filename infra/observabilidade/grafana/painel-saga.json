          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "fechado",
                  "color": "green"
                },
                "1": {
                  "text": "meio-aberto",
                  "color": "yellow"
                },
                "2": {
                  "text": "aberto",
                  "color": "red"
                }
              }
            }
          ],
          "min": 0,
          "max": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
