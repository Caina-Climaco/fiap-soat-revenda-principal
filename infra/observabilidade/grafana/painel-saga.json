      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "0 fechado, 1 meio-aberto, 2 aberto",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
